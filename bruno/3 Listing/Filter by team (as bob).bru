meta {
  name: Filter by team (as bob)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/notes?teamId={{teamId}}
  body: none
  auth: none
}

headers {
  x-user-id: {{bobId}}
}

tests {
  test("three team notes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(3);
  });
}
