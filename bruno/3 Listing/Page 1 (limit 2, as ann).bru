meta {
  name: Page 1 (limit 2, as ann)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/notes?limit=2
  body: none
  auth: none
}

headers {
  x-user-id: {{annId}}
}

script:post-response {
  bru.setVar("cursor", res.body.nextCursor);
}

tests {
  test("first page has a cursor", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(2);
    expect(res.body.nextCursor).to.be.a("string");
  });
}
