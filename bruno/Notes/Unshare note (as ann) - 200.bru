meta {
  name: Unshare note (as ann) - 200
  type: http
  seq: 23
}

patch {
  url: {{baseUrl}}/notes/{{sharedNoteId}}
  body: json
  auth: none
}

headers {
  authorization: Bearer {{annToken}}
}

body:json {
  {
    "teamId": null
  }
}

tests {
  test("author can make it private", function () {
    expect(res.status).to.equal(200);
    expect(res.body.teamId).to.equal(null);
  });
}
