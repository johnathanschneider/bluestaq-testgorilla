meta {
  name: Create shared note - Standup (as ann)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/notes
  body: json
  auth: none
}

headers {
  authorization: Bearer {{annToken}}
}

body:json {
  {
    "title": "Standup",
    "body": "ship the notes API this week",
    "tags": ["meeting"],
    "teamId": "{{teamId}}"
  }
}

script:post-response {
  bru.setVar("sharedNoteId", res.body.id);
}

tests {
  test("shared note created", function () {
    expect(res.status).to.equal(201);
    expect(res.body.teamId).to.equal(bru.getVar("teamId"));
  });
}
