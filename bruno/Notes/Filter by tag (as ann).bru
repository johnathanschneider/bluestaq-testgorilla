meta {
  name: Filter by tag (as ann)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/notes?tag=meeting
  body: none
  auth: none
}

headers {
  x-user-id: {{annId}}
}

tests {
  test("two meeting notes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(2);
  });
}
