meta {
  name: Get shared note (as bob) - 200
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/notes/{{sharedNoteId}}
  body: none
  auth: none
}

headers {
  x-user-id: {{bobId}}
}

tests {
  test("team member can read", function () {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Standup");
  });
}
