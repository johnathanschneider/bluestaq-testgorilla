meta {
  name: Page 2 (cursor from page 1)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/notes?limit=2&cursor={{cursor}}
  body: none
  auth: none
}

headers {
  x-user-id: {{annId}}
}

tests {
  test("second page is the last", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(2);
    expect(res.body.nextCursor).to.equal(null);
  });
}
