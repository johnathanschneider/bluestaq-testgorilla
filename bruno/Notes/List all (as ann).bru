meta {
  name: List all (as ann)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/notes
  body: none
  auth: none
}

headers {
  authorization: Bearer {{annToken}}
}

tests {
  test("ann sees her private note plus all team notes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(4);
    expect(res.body.nextCursor).to.equal(null);
  });
}
