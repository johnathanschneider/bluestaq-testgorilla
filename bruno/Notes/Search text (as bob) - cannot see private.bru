meta {
  name: Search text (as bob) - cannot see private
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/notes?q=avocado
  body: none
  auth: none
}

headers {
  x-user-id: {{bobId}}
}

tests {
  test("search never leaks private notes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.have.length(0);
  });
}
