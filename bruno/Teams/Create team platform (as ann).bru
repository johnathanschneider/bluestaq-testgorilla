meta {
  name: Create team platform (as ann)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/teams
  body: json
  auth: none
}

headers {
  authorization: Bearer {{annToken}}
}

body:json {
  {
    "name": "platform"
  }
}

script:post-response {
  bru.setVar("teamId", res.body.id);
}

tests {
  test("team created", function () {
    expect(res.status).to.equal(201);
  });
}
