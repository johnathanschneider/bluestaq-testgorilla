meta {
  name: Login ann second session
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {"username": "ann", "password": "{{password}}"}
}

script:post-response {
  bru.setVar("annTempToken", res.body.token);
}

tests {
  test("second token issued", function () {
    expect(res.status).to.equal(200);
  });
}
