meta {
  name: Login cara
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {"username": "cara", "password": "{{password}}"}
}

script:post-response {
  bru.setVar("caraToken", res.body.token);
}

tests {
  test("token issued", function () {
    expect(res.status).to.equal(200);
    expect(res.body.token).to.be.a("string");
    expect(res.body.expiresAt).to.be.a("string");
  });
}
